{
  "manifest_version": 3,
  "name": "AIRS 演示中心",
  "version": "1.3.0",
  "description": "Prisma AIRS 运行时防护演示中心 · 通过 Portkey AI Gateway 演示拦截、成本控制、缓存分流",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "AIRS 演示中心",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
